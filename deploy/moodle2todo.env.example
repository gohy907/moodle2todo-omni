# Copy to ~/.config/moodle2todo.env and chmod 600 it.
# Format: KEY=value, one per line, no `export`, no shell expansion.
# Quote values that contain spaces or `;`. `&` in URLs needs no quoting.

# Moodle: Calendar -> Export calendar -> Get calendar URL (a secret!)
MOODLE_ICS_URL=https://moodle.example.com/calendar/export_execute.php?userid=123&authtoken=TOKEN&preset_what=all&preset_time=custom

# CalDAV server: the calendar collection that will hold the tasks, and credentials
CALENDAR_URL=https://caldav.example.com/path/to/moodle-tasks/
CALDAV_USER=change-me
CALDAV_PASSWORD=change-me

# Uncomment if the server requires Calino-style resource names (anytype-caldav does)
#CALDAV_RESOURCE_NAMING=calino

# Sync every 30 minutes
SYNC_INTERVAL_SECS=1800

# Optional: courses to skip, separated by `;`
#EXCLUDE_CATEGORIES="Old course;Another old course"
